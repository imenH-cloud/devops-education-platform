# Production environment file
# DO NOT commit this file - use Kubernetes Secrets instead

NODE_ENV=production
SERVICE_NAME=api-gateway
LOG_LEVEL=info
LOG_FORMAT=json
PROMETHEUS_ENABLED=true
METRICS_PORT=9090

# Database
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=changeme_in_production
DB_NAME=education

# Services
AUTH_SERVICE_HOST=auth-service
AUTH_SERVICE_PORT=3001
USER_SERVICE_HOST=user-service
USER_SERVICE_PORT=3002
ACTIVITY_SERVICE_HOST=activity-service
ACTIVITY_SERVICE_PORT=3003
PARENT_SERVICE_HOST=parent-service
PARENT_SERVICE_PORT=3004
STUDENT_SERVICE_HOST=student-service
STUDENT_SERVICE_PORT=3005
CLASSROOM_SERVICE_HOST=classroom-service
CLASSROOM_SERVICE_PORT=3006
TEACHER_SERVICE_HOST=teacher-service
TEACHER_SERVICE_PORT=3007

# Security
JWT_SECRET=change_this_secret
JWT_EXPIRATION=24h
API_RATE_LIMIT=100

# CORS
CORS_ORIGIN=https://api.example.com
CORS_CREDENTIALS=true

# External Services
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_TTL=3600
