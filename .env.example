# ============================================================================
# DevOps Education Platform - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in the values
# NEVER commit this file to version control if it contains secrets
# ============================================================================

# ============================================================================
# DATABASE - PostgreSQL Configuration
# ============================================================================
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=education

# ============================================================================
# REDIS - Cache Configuration
# ============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=3600

# ============================================================================
# RABBITMQ - Message Broker Configuration
# ============================================================================
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# ============================================================================
# ELASTICSEARCH - Search & Logging Configuration
# ============================================================================
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# ============================================================================
# KIBANA - Logs Visualization
# ============================================================================
KIBANA_HOST=kibana
KIBANA_PORT=5601
KIBANA_URL=http://kibana:5601

# ============================================================================
# MINIO - Object Storage Configuration
# ============================================================================
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_BUCKET=education

# ============================================================================
# PROMETHEUS - Metrics Configuration
# ============================================================================
PROMETHEUS_HOST=prometheus
PROMETHEUS_PORT=9090
PROMETHEUS_URL=http://prometheus:9090

# ============================================================================
# GRAFANA - Metrics Visualization
# ============================================================================
GRAFANA_HOST=grafana
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_URL=http://grafana:3000

# ============================================================================
# NODE & APPLICATION Configuration
# ============================================================================
NODE_ENV=development
LOG_LEVEL=debug
LOG_FORMAT=json

# ============================================================================
# API GATEWAY Configuration
# ============================================================================
GATEWAY_HOST=gateway-backend
GATEWAY_PORT=3000
GATEWAY_URL=http://gateway-backend:3000
API_PREFIX=/api

# ============================================================================
# MICROSERVICES Configuration
# ============================================================================
USER_SERVICE_HOST=user-service
USER_SERVICE_PORT=3002
USER_SERVICE_URL=http://user-service:3002

AUTH_SERVICE_HOST=auth-service
AUTH_SERVICE_PORT=3001
AUTH_SERVICE_URL=http://auth-service:3001

ACTIVITY_SERVICE_HOST=activity-service
ACTIVITY_SERVICE_PORT=3003
ACTIVITY_SERVICE_URL=http://activity-service:3003

CLASSROOM_SERVICE_HOST=classroom-service
CLASSROOM_SERVICE_PORT=3006
CLASSROOM_SERVICE_URL=http://classroom-service:3006

PARENT_SERVICE_HOST=parent-service
PARENT_SERVICE_PORT=3004
PARENT_SERVICE_URL=http://parent-service:3004

STUDENT_SERVICE_HOST=student-service
STUDENT_SERVICE_PORT=3005
STUDENT_SERVICE_URL=http://student-service:3005

TEACHER_SERVICE_HOST=teacher-service
TEACHER_SERVICE_PORT=3007
TEACHER_SERVICE_URL=http://teacher-service:3007

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRATION=24h
JWT_REFRESH_SECRET=your-refresh-token-secret
JWT_REFRESH_EXPIRATION=7d

API_KEY=your-api-key-change-this
API_KEY_SECRET=your-api-key-secret

CORS_ORIGIN=http://localhost:4200
CORS_CREDENTIALS=true
CORS_MAX_AGE=3600

# ============================================================================
# FRONTEND Configuration
# ============================================================================
FRONTEND_HOST=frontend-app
FRONTEND_PORT=4200
FRONTEND_URL=http://localhost:4200

# ============================================================================
# EMAIL Service Configuration (Optional)
# ============================================================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@devops-education.com

# ============================================================================
# AWS/Cloud Configuration (Optional)
# ============================================================================
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_S3_BUCKET=devops-education

# ============================================================================
# SENTRY - Error Tracking (Optional)
# ============================================================================
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ============================================================================
# SENDGRID - Email Service (Optional)
# ============================================================================
# SENDGRID_API_KEY=SG.xxxxxxxxxxxx

# ============================================================================
# GOOGLE ANALYTICS (Optional)
# ============================================================================
# GOOGLE_ANALYTICS_ID=UA-XXXXXXXX-X

# ============================================================================
# DOCKER CONFIGURATION
# ============================================================================
DOCKER_REGISTRY=docker.io
DOCKER_USERNAME=your-docker-username
DOCKER_PASSWORD=your-docker-password

# ============================================================================
# KUBERNETES Configuration
# ============================================================================
KUBE_NAMESPACE=prod
KUBE_CONTEXT=docker-desktop

# ============================================================================
# HELM Configuration
# ============================================================================
HELM_CHART_VERSION=2.1.0
HELM_RELEASE_NAME=devops-education

# ============================================================================
# MONITORING & ALERTING
# ============================================================================
ALERT_EMAIL=devops@example.com
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
PAGERDUTY_KEY=your-pagerduty-key

# ============================================================================
# DATABASE BACKUP Configuration
# ============================================================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * * # 2 AM daily
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE=s3://backups/

# ============================================================================
# RATE LIMITING
# ============================================================================
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================================
# SESSION Configuration
# ============================================================================
SESSION_SECRET=your-session-secret-key
SESSION_TIMEOUT=3600 # 1 hour

# ============================================================================
# FILE UPLOAD Configuration
# ============================================================================
MAX_FILE_SIZE=52428800 # 50MB
ALLOWED_FILE_TYPES=pdf,doc,docx,xls,xlsx,ppt,pptx,jpg,jpeg,png,zip

# ============================================================================
# PAGINATION Configuration
# ============================================================================
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ============================================================================
# LOGGING Configuration
# ============================================================================
LOG_TO_FILE=true
LOG_FILE_PATH=/var/log/app/
LOG_MAX_SIZE=10485760 # 10MB
LOG_MAX_FILES=10

# ============================================================================
# TIMEZONE
# ============================================================================
TZ=UTC
APP_TIMEZONE=Europe/Paris

# ============================================================================
# FEATURE FLAGS (Optional)
# ============================================================================
FEATURE_NEW_UI=true
FEATURE_DARK_MODE=true
FEATURE_ANALYTICS=true
FEATURE_EXPORT_PDF=true

# ============================================================================
# NOTES:
# - In production, store secrets in secure vaults (e.g., HashiCorp Vault)
# - Change default passwords and API keys
# - Use strong JWT secrets
# - Enable TLS/SSL in production
# - Keep sensitive data encrypted
# - Use environment-specific configurations
# ============================================================================
