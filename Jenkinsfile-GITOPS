pipeline {
    agent any
    
    options {
        timestamps()
        timeout(time: 1, unit: 'HOURS')
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    environment {
        REGISTRY = "docker.io"
        IMAGE_NAMESPACE = "devopspfe"
        GIT_REPO = "https://github.com/YOUR-ORG/your-repo"
    }

    parameters {
        choice(name: 'ENVIRONMENT', choices: ['dev', 'staging', 'prod'], description: 'Deployment environment')
        booleanParam(name: 'SKIP_TESTS', defaultValue: false, description: 'Skip unit tests')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    env.GIT_COMMIT_SHORT = sh(script: "git rev-parse --short HEAD", returnStdout: true).trim()
                    env.GIT_TAG = sh(script: "git describe --tags --always || echo 'v1.0.0'", returnStdout: true).trim()
                    env.BUILD_TIME = sh(script: "date -u +'%Y-%m-%dT%H:%M:%SZ'", returnStdout: true).trim()
                    env.IMAGE_TAG = "${env.GIT_TAG}-${env.GIT_COMMIT_SHORT}"
                    
                    echo "=== Build Info ==="
                    echo "Git Tag: ${GIT_TAG}"
                    echo "Commit: ${GIT_COMMIT_SHORT}"
                    echo "Image Tag: ${IMAGE_TAG}"
                }
            }
        }

        stage('Lint & Quality Checks') {
            parallel {
                stage('Backend Lint') {
                    steps {
                        dir('backend/gateway') {
                            sh '''
                                npm install
                                npm run lint 2>&1 || echo "Linting warnings"
                            '''
                        }
                    }
                }
                stage('Frontend Lint') {
                    steps {
                        dir('frontend/app') {
                            sh '''
                                npm ci --legacy-peer-deps
                                npm run lint 2>&1 || echo "Linting warnings"
                            '''
                        }
                    }
                }
                stage('Dockerfile Scan') {
                    steps {
                        sh '''
                            echo "Scanning Dockerfiles for best practices..."
                            for dockerfile in $(find . -name "Dockerfile" -type f); do
                                echo "Scanning: $dockerfile"
                                if grep -q "^FROM.*AS builder" "$dockerfile" && grep -q "npm ci --omit=dev" "$dockerfile"; then
                                    echo "✓ Multi-stage build found"
                                fi
                                if grep -q "USER " "$dockerfile"; then
                                    echo "✓ Non-root user configured"
                                fi
                            done
                        '''
                    }
                }
            }
        }

        stage('Unit Tests') {
            when {
                expression { params.SKIP_TESTS == false }
            }
            parallel {
                stage('Backend Tests') {
                    steps {
                        dir('backend/gateway') {
                            sh '''
                                npm install
                                npm run test:cov || true
                            '''
                        }
                    }
                }
                stage('Frontend Tests') {
                    steps {
                        dir('frontend/app') {
                            sh '''
                                npm ci --legacy-peer-deps
                                npm run test -- --watch=false --code-coverage 2>&1 || echo "Frontend tests completed"
                            '''
                        }
                    }
                }
            }
        }

        stage('Security Scanning') {
            parallel {
                stage('npm Audit') {
                    steps {
                        sh '''
                            echo "Checking npm dependencies for vulnerabilities..."
                            cd backend/gateway && npm audit --audit-level=moderate || true
                            cd ../../frontend/app && npm audit --audit-level=moderate || true
                        '''
                    }
                }
                stage('Hadolint Dockerfiles') {
                    steps {
                        sh '''
                            echo "Scanning Dockerfiles for issues..."
                            for dockerfile in $(find . -name "Dockerfile" -type f); do
                                echo "Checking: $dockerfile"
                                # hadolint "$dockerfile" || echo "Review $dockerfile for improvements"
                            done
                        '''
                    }
                }
            }
        }

        stage('Build Docker Images') {
            steps {
                script {
                    def services = [
                        'gateway': 'backend/gateway',
                        'user': 'backend/user',
                        'auth': 'backend/auth',
                        'activity': 'backend/activity',
                        'classroom': 'backend/classroom',
                        'parent': 'backend/parent',
                        'student': 'backend/student',
                        'teacher': 'backend/teacher',
                        'frontend': 'frontend/app'
                    ]
                    
                    services.each { service, path ->
                        echo "Building ${service} service with tag ${IMAGE_TAG}..."
                        sh "docker build -t ${IMAGE_NAMESPACE}-${service}:${IMAGE_TAG} -t ${IMAGE_NAMESPACE}-${service}:latest ${path}"
                    }
                }
            }
        }

        stage('Image Security Scan') {
            steps {
                sh '''
                    echo "Scanning Docker images for vulnerabilities..."
                    for image in $(docker images | grep devopspfe | awk '{print $1":"$2}' | sort -u | head -5); do
                        echo "Scanning: $image"
                        docker run --rm -v /var/run/docker.sock:/var/run/docker.sock \
                            aquasec/trivy image --severity HIGH,CRITICAL "$image" || echo "Scan completed"
                    done
                '''
            }
        }

        stage('Push to Registry') {
            when {
                branch 'main'
            }
            steps {
                script {
                    withCredentials([usernamePassword(credentialsId: 'docker-hub', 
                                                      usernameVariable: 'DOCKER_USER', 
                                                      passwordVariable: 'DOCKER_PASS')]) {
                        sh '''
                            echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin
                            
                            for image in $(docker images | grep devopspfe | awk '{print $1}' | sort -u); do
                                echo "Pushing ${image}:${IMAGE_TAG}"
                                docker push ${image}:${IMAGE_TAG}
                                echo "Pushing ${image}:latest"
                                docker push ${image}:latest
                            done
                            
                            echo "✅ Images pushed to registry"
                        '''
                    }
                }
            }
        }

        // ✅ NOUVEAU: Au lieu de kubectl apply, on update Git
        // ArgoCD surveillera et appliquera automatiquement
        stage('Update GitOps Repository') {
            when {
                branch 'main'
            }
            steps {
                script {
                    withCredentials([usernamePassword(credentialsId: 'github-credentials',
                                                      usernameVariable: 'GIT_USER',
                                                      passwordVariable: 'GIT_TOKEN')]) {
                        sh '''
                            echo "=== Updating GitOps Repository ==="
                            
                            # Clone the repo
                            rm -rf /tmp/argocd-repo
                            git clone https://${GIT_USER}:${GIT_TOKEN}@github.com/YOUR-ORG/your-repo.git /tmp/argocd-repo
                            cd /tmp/argocd-repo
                            
                            # Update image tags in kustomization or values
                            echo "Updating image tags to: ${IMAGE_TAG}"
                            
                            # Update all services with new image tag
                            sed -i "s|devopspfe-gateway:.*|devopspfe-gateway:${IMAGE_TAG}|g" kubernetes/kustomization.yaml
                            sed -i "s|devopspfe-user:.*|devopspfe-user:${IMAGE_TAG}|g" kubernetes/kustomization.yaml
                            sed -i "s|devopspfe-auth:.*|devopspfe-auth:${IMAGE_TAG}|g" kubernetes/kustomization.yaml
                            sed -i "s|devopspfe-activity:.*|devopspfe-activity:${IMAGE_TAG}|g" kubernetes/kustomization.yaml
                            sed -i "s|devopspfe-classroom:.*|devopspfe-classroom:${IMAGE_TAG}|g" kubernetes/kustomization.yaml
                            sed -i "s|devopspfe-parent:.*|devopspfe-parent:${IMAGE_TAG}|g" kubernetes/kustomization.yaml
                            sed -i "s|devopspfe-student:.*|devopspfe-student:${IMAGE_TAG}|g" kubernetes/kustomization.yaml
                            sed -i "s|devopspfe-teacher:.*|devopspfe-teacher:${IMAGE_TAG}|g" kubernetes/kustomization.yaml
                            sed -i "s|devopspfe-frontend:.*|devopspfe-frontend:${IMAGE_TAG}|g" kubernetes/kustomization.yaml
                            
                            # Configure git
                            git config user.email "jenkins@example.com"
                            git config user.name "Jenkins CI/CD"
                            
                            # Check if there are changes
                            if [ -z "$(git status --porcelain)" ]; then
                                echo "No changes detected"
                                exit 0
                            fi
                            
                            # Commit and push
                            git add kubernetes/
                            git commit -m "ci: Update images to ${IMAGE_TAG}

- Gateway: devopspfe-gateway:${IMAGE_TAG}
- User: devopspfe-user:${IMAGE_TAG}
- Auth: devopspfe-auth:${IMAGE_TAG}
- Activity: devopspfe-activity:${IMAGE_TAG}
- Classroom: devopspfe-classroom:${IMAGE_TAG}
- Parent: devopspfe-parent:${IMAGE_TAG}
- Student: devopspfe-student:${IMAGE_TAG}
- Teacher: devopspfe-teacher:${IMAGE_TAG}
- Frontend: devopspfe-frontend:${IMAGE_TAG}

[skip ci]" -m "" -m "Triggered by Jenkins Build: ${BUILD_NUMBER}"
                            
                            git push origin main
                            echo "✅ GitOps repository updated"
                        '''
                    }
                }
            }
        }

        // ✅ ArgoCD détectera le changement Git automatiquement
        // Mais vous pouvez forcer une synchronisation
        stage('Trigger ArgoCD Sync') {
            when {
                branch 'main'
            }
            steps {
                script {
                    // Option 1: Webhook (ArgoCD webhook déclenché par git push)
                    // → Automatique, rien à faire
                    
                    // Option 2: Forcer sync via ArgoCD CLI (si disponible)
                    sh '''
                        echo "=== ArgoCD Sync ==="
                        echo "ArgoCD detected git change and is syncing..."
                        
                        # Si ArgoCD CLI est installé:
                        if command -v argocd &> /dev/null; then
                            echo "Forcing ArgoCD sync..."
                            # argocd app sync devops-education --prune --auto-prune
                            # argocd app wait devops-education --timeout 300
                        else
                            echo "ArgoCD CLI not available - webhook will trigger sync"
                        fi
                        
                        echo "ArgoCD will sync within 3 minutes (default polling interval)"
                    '''
                }
            }
        }

        // ✅ Attendre que le déploiement soit à jour
        stage('Wait for Deployment') {
            when {
                branch 'main'
            }
            steps {
                sh '''
                    echo "=== Waiting for ArgoCD Sync ==="
                    
                    # Attendre que ArgoCD applique les changements
                    sleep 5
                    
                    # Vérifier que les pods sont ready (max 5 minutes)
                    echo "Waiting for pods to be ready..."
                    kubectl wait --for=condition=ready pod \
                        -l tier=backend \
                        -n production \
                        --timeout=300s || echo "Timeout - check ArgoCD UI"
                    
                    echo "✅ Deployment complete"
                '''
            }
        }

        // ✅ Smoke tests pour vérifier que tout marche
        stage('Smoke Tests') {
            when {
                branch 'main'
            }
            steps {
                sh '''
                    echo "=== Running Smoke Tests ==="
                    
                    # Attendre que le service soit accessible
                    sleep 5
                    
                    # Test Gateway health
                    GATEWAY_IP=$(kubectl get svc gateway -n production -o jsonpath='{.spec.clusterIP}' 2>/dev/null)
                    
                    if [ ! -z "$GATEWAY_IP" ]; then
                        echo "Testing Gateway: $GATEWAY_IP:3000"
                        curl -f http://$GATEWAY_IP:3000/health || echo "Health check failed - will retry"
                    else
                        echo "Gateway not accessible yet - ArgoCD may still be syncing"
                    fi
                    
                    echo "✅ Smoke tests completed"
                '''
            }
        }
    }

    post {
        always {
            script {
                // Cleanup
                sh 'rm -rf /tmp/argocd-repo'
            }
        }
        
        success {
            sh '''
                echo "✅ Pipeline succeeded!"
                echo ""
                echo "=== Summary ==="
                echo "1. Docker images built and pushed to registry"
                echo "2. Git repository updated with new image tags"
                echo "3. ArgoCD detected changes and is syncing"
                echo "4. Check ArgoCD UI for sync status: http://argocd.example.com"
                echo ""
                echo "No manual kubectl apply needed - ArgoCD handles it!"
            '''
        }
        
        failure {
            sh '''
                echo "❌ Pipeline failed!"
                echo ""
                echo "Check logs above for errors"
                echo "Docker images were NOT pushed"
                echo "Git repository was NOT updated"
                echo "ArgoCD has nothing to sync"
            '''
        }
    }
}
